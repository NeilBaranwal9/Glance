    "formula": "x_scaled = clip((x - min) / (max - min), -0.5, 1.5)"
  },
  "output": {
    "shape": [
      -1
    ],
    "dtype": "float64",
    "meaning": "health score, 100 = as-new, 0 = at failure",
    "range": [
      0,
      100
    ],
    "postprocess": "clip to [0, 100] -- the regressor can overshoot slightly",
    "target_definition": "100 * clip(RUL / 125, 0, 1)",
    "rul_equivalent": "rul_cycles = health / 100 * 125; an RMSE of h health points equals h * 1.25 cycles of RUL error"
  },
  "thresholds": {
    "suggested_display_bands": {
      "healthy": "health > 60",
      "degrading": "24 <= health <= 60",
      "critical": "health < 24"
    },
    "note": "these bands are the LSTM's RUL stage thresholds (75 and 30 cycles) expressed as health points, so the two models agree by construction"
  },
  "artifacts": {
    "catboost": "catboost_health.cbm"
  },
  "inference": {
    "protocol": [
      "1. Collect one telemetry cycle as the 17 raw features, in input.feature_names order.",
      "2. Normalize with normalization.min/max per the stated formula.",
      "3. model = catboost.CatBoostRegressor(); model.load_model('catboost_health.cbm')",
      "4. health = float(model.predict(x.reshape(1, -1))[0])",
      "5. health = min(100.0, max(0.0, health))"
    ],
    "loader": "catboost.CatBoostRegressor().load_model",
    "requires": [
      "catboost",
      "numpy"
    ],
    "stateless": true,
    "note": "expects the SAME normalized features as the autoencoder, so one normalized row can be fed to both"
  },
