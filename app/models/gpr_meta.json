  "inference": {
    "protocol": [
      "1. Keep a rolling buffer of the last 30 cycles of s11.",
      "2. Normalize each value using normalization.min/max at this sensor's index.",
      "3. gp = joblib.load('gpr.pkl')",
      "4. past_t = (numpy.arange(30) / 30).reshape(-1, 1)",
      "5. gp.fit(past_t, buffer)  -- optimizer is None, so this only conditions (one 30x30 Cholesky, sub-millisecond); it does NOT refit hyperparameters",
      "6. future_t = (numpy.arange(30, 45) / 30).reshape(-1, 1)",
      "7. mean, std = gp.predict(future_t, return_std=True)",
      "8. band = mean +/- 1.959963984540054 * std"
    ],
    "time_grid": {
